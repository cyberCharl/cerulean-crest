APP_TIME_ZONE=Africa/Johannesburg
# Each environment has its own database. Leave unset for local SQLite.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:password@host/database?sslmode=require
# Run npm run db:migrate before using a fresh Postgres database.
# Run npm run db:seed to explicitly create the demo issue outside production.
SEED_DEMO=false

# Local MCP inspection only; ignored on Vercel. The token acts as this subject.
CERULEAN_MCP_DEV_TOKEN=replace-with-a-long-random-token
# CERULEAN_MCP_DEV_SUBJECT=dev-reader
# Legacy canonical origin (CERULEAN_APP_URL takes precedence).
# CERULEAN_SITE_URL=https://cerulean-crest.vercel.app

# Browser login and URL configuration. Use an origin without a path.
# For local login, register http://localhost:3000/auth/callback in Auth0.
# CERULEAN_APP_URL=http://localhost:3000
# CERULEAN_MARKETING_URL=http://localhost:3000
# AUTH0_DOMAIN=YOUR-PROVIDER.auth0.com
# AUTH0_CLIENT_ID=your-browser-application-client-id
# AUTH0_CLIENT_SECRET=your-browser-application-client-secret
# AUTH0_SECRET=generate-a-random-64-character-hex-string
# Later, both domains can point to the same Vercel project:
# CERULEAN_APP_URL=https://app.your-final-domain.com
# CERULEAN_MARKETING_URL=https://your-final-domain.com
# Set only after publication, using the real directory link from ChatGPT.
# CERULEAN_CHATGPT_PLUGIN_URL=https://chatgpt.com/...

# OAuth for AI tools. The resource is the audience and the URL readers connect to.
# CERULEAN_OAUTH_ISSUER=https://YOUR-PROVIDER/
# CERULEAN_OAUTH_JWKS_URL=https://YOUR-PROVIDER/.well-known/jwks.json
# CERULEAN_MCP_RESOURCE=https://filtered.page/mcp

# Account deletion also removes the reader's Auth0 user when this is set. It reuses
# AUTH0_CLIENT_ID/SECRET, so that client needs client credentials and only
# delete:users on the Management API. Use the tenant's own domain, not the custom one.
# AUTH0_MANAGEMENT_DOMAIN=YOUR-TENANT.eu.auth0.com
